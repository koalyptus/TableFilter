/**
 * Global variables
 */

// table
$font-family =                          inherit
$padding =                              0.5em 0.7em
$min-width =                            35px
$min-height =                           35px

// header cell
$th-height =                            35px
$th-bg-color =                          var(--tf-header-bg, #EAEAEA)
$th-padding =                           5px
$th-font-color =                        var(--tf-text, #333)
$th-bottom-border-color =               var(--tf-border, #CCC)
$th-top-border-color =                 var(--tf-border-light, #F4F4F4)
$th-left-border-color =                var(--tf-border, #CCC)
$th-right-border-color =               var(--tf-border-light, #F4F4F4)

// cell
$td-border-color =                      var(--tf-cell-border, #C6C6C6)

// filters
$filter-font-color =                    var(--tf-text-secondary, #444)
$filter-row-bg-color =                  var(--tf-header-bg, #EAEAEA)
$filter-bg-color =                      var(--tf-bg, #FFF)
$filter-border-color =                  var(--tf-border-light, #F4F4F4)
$filter-height =                        35px

// toolbar container (.inf)
$toolbar-bg-color =                     var(--tf-bg, #FFF)
$toolbar-font-size =                    inherit
$toolbar-border-color =                 var(--tf-border, #CCC)
$toolbar-divider-color =                var(--tf-border-light, #F4F4F4)
$toolbar-hover-color =                  var(--tf-border-light, #F4F4F4)

// paging
$paging-nav-button-bg-color-hover =     var(--tf-border-light, #F4F4F4)

// grid layout
$grid-layout-bg-color =                 var(--tf-grid-bg, #C8E0FB)
$grid-layout-border-color =             var(--tf-grid-border, #99BBE8)

